## Combined .gitignore for a .NET back end and a Vite + React front end.
## Based on https://github.com/github/gitignore (Dotnet, VisualStudio, Node).

# ---------------------------------------------------------------
# .NET
# ---------------------------------------------------------------

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Publish output
[Pp]ublish/
*.[Pp]ublish.xml
*.pubxml
*.publishproj

# Test results and coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
CodeCoverage/
coverage*.json
coverage*.xml
*.coverage
*.coveragexml

# MSBuild logs
*.binlog

# Local user secrets / settings
appsettings.Development.local.json
appsettings.*.local.json

# ---------------------------------------------------------------
# Vite + React (Node)
# ---------------------------------------------------------------

node_modules/
dist/
dist-ssr/
*.local
.vite/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript build info
*.tsbuildinfo

# ---------------------------------------------------------------
# Environment variables (never commit secrets)
# ---------------------------------------------------------------

.env
.env.*
!.env.example

# ---------------------------------------------------------------
# IDEs and editors
# ---------------------------------------------------------------

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# JetBrains Rider / WebStorm
.idea/
*.sln.iml

# VS Code (keep shared settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Vim / misc
*.sw?
*~
~$*

# ---------------------------------------------------------------
# OS files
# ---------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini
